From 4913dab57ef91e6d3975fede0b5850660bbf8c36 Mon Sep 17 00:00:00 2001
From: Paolo Anz <paoloanzn@users.noreply.github.com>
Date: Fri, 7 Aug 2026 16:59:00 +0000
Subject: [PATCH] fix(ai): harden Claude Code cch body patching

---
 packages/ai/src/api/anthropic-claude-code.ts  | 37 ++++++++++++++-----
 .../ai/test/anthropic-claude-code.test.ts     | 22 +++++++++++
 2 files changed, 49 insertions(+), 10 deletions(-)

diff --git a/packages/ai/src/api/anthropic-claude-code.ts b/packages/ai/src/api/anthropic-claude-code.ts
index 3b23b906..438312e0 100644
--- a/packages/ai/src/api/anthropic-claude-code.ts
+++ b/packages/ai/src/api/anthropic-claude-code.ts
@@ -117,20 +117,37 @@ export async function buildClaudeCodeBillingHeader(messages: Message[]): Promise
 }
 
 export function patchClaudeCodeCch(serializedBody: string): string {
-	if (!serializedBody.includes(CCH_PLACEHOLDER)) {
-		throw new Error("Claude Code OAuth request is missing the cch placeholder");
+	let body: Record<string, unknown>;
+	try {
+		const parsed = JSON.parse(serializedBody);
+		if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) throw new Error("not an object");
+		body = parsed as Record<string, unknown>;
+	} catch {
+		throw new Error("Claude Code OAuth request body is not a JSON object");
 	}
-	const withoutModelValue = serializedBody.replace(/(?<="model":")[^"]*(?=")/, "");
-	if (withoutModelValue === serializedBody) {
-		throw new Error("Claude Code OAuth request has no serialized model value to omit from cch");
+	const system = body.system;
+	if (!Array.isArray(system) || typeof system[0] !== "object" || system[0] === null || Array.isArray(system[0])) {
+		throw new Error("Claude Code OAuth request is missing the billing system block");
 	}
-	const normalized = withoutModelValue.replace(/"max_tokens":[^,]*,/, "");
-	if (normalized === withoutModelValue) {
-		throw new Error("Claude Code OAuth request has no serialized max_tokens member to omit from cch");
+	const billingBlock = system[0] as Record<string, unknown>;
+	if (typeof billingBlock.text !== "string" || !billingBlock.text.startsWith("x-anthropic-billing-header: ")) {
+		throw new Error("Claude Code OAuth request has an invalid billing system block");
 	}
-	const hash = xxHash64(new TextEncoder().encode(normalized), CCH_SEED);
+	if (!billingBlock.text.includes(CCH_PLACEHOLDER)) {
+		if (/; cch=[0-9a-f]{5};$/u.test(billingBlock.text)) return serializedBody;
+		throw new Error("Claude Code OAuth request has an invalid cch billing value");
+	}
+	if (typeof body.model !== "string" || !("max_tokens" in body)) {
+		throw new Error("Claude Code OAuth request is missing model or max_tokens");
+	}
+
+	const normalized = structuredClone(body);
+	normalized.model = "";
+	delete normalized.max_tokens;
+	const hash = xxHash64(new TextEncoder().encode(JSON.stringify(normalized)), CCH_SEED);
 	const cch = (hash & 0xfffffn).toString(16).padStart(5, "0");
-	return serializedBody.replace(CCH_PLACEHOLDER, `cch=${cch}`);
+	billingBlock.text = billingBlock.text.replace(CCH_PLACEHOLDER, `cch=${cch}`);
+	return JSON.stringify(body);
 }
 
 function requestHeaders(input: Parameters<FetchFunction>[0], init?: RequestInit): Headers {
diff --git a/packages/ai/test/anthropic-claude-code.test.ts b/packages/ai/test/anthropic-claude-code.test.ts
index fd1a282f..04e37cc4 100644
--- a/packages/ai/test/anthropic-claude-code.test.ts
+++ b/packages/ai/test/anthropic-claude-code.test.ts
@@ -30,6 +30,28 @@ describe("Claude Code Anthropic request compatibility", () => {
 		expect(patchClaudeCodeCch(body)).toContain("cch=7ba34");
 	});
 
+	it("patches only the billing block when user and nested fields collide", () => {
+		const body = {
+			model: "claude-opus-5",
+			messages: [{ role: "user", content: "cch=00000", model: "nested", max_tokens: 7 }],
+			max_tokens: 64000,
+			stream: true,
+			system: [
+				{
+					type: "text",
+					text: "x-anthropic-billing-header: cc_version=2.1.224.000; cc_entrypoint=sdk-cli; cch=00000;",
+				},
+				{ type: "text", text: "fake cch=00000" },
+			],
+			tools: [{ name: "probe", description: "model max_tokens cch=00000" }],
+		};
+		const patched = JSON.parse(patchClaudeCodeCch(JSON.stringify(body))) as typeof body;
+		expect(patched.system[0].text).toMatch(/cch=[0-9a-f]{5};$/);
+		expect(patched.messages).toEqual(body.messages);
+		expect(patched.system[1]).toEqual(body.system[1]);
+		expect(patched.tools).toEqual(body.tools);
+	});
+
 	it("patches the final SDK body and generates a request UUID", async () => {
 		const body =
 			'{"model":"claude-opus-5","messages":[],"max_tokens":1,"stream":true,"system":[{"type":"text","text":"x-anthropic-billing-header: cc_version=2.1.224.000; cc_entrypoint=sdk-cli; cch=00000;"}]}';
